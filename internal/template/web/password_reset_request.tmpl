{{define "password_reset_status"}}{{template "message" .}}{{end}}
{{template "page_top" "Reset your password"}}
		<h1>Reset your password</h1>
		<form hx-post="/password/reset" hx-target="#status">
			{{template "email_field"}}
			<button type="submit">Send reset link</button>
		</form>
		{{template "status"}}
		<div class="meta">
			<p><a href="/sign-in">Back to sign in</a></p>
		</div>
{{template "page_bottom"}}
