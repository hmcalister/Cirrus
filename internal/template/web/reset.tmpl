{{define "reset_error"}}{{template "message" .}}{{end}}
{{template "page_top" "Choose a new password"}}
		<h1>Choose a new password</h1>
		<form hx-post="/reset" hx-disabled="find button">
			<input type="hidden" name="token" value="{{.Token}}" hx-target="#status">
			<label>
				New password
				<input type="password" name="password" autocomplete="new-password" required>
			</label>
			<button type="submit">Set new password</button>
		</form>
		{{template "status"}}
{{template "page_bottom"}}
