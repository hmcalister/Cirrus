{{template "page_top" "Sign in"}}
		<h1>Sign in</h1>
		<p class="lede">Enter your email address and we'll send you a sign-in link. No password required.</p>
		<form hx-post="/auth/magic-link" hx-disabled="find button" hx-target="#sign-in-status">
			{{template "email_field"}}
			<button type="submit">Get sign-in link</button>
		</form>
		<div id="sign-in-status" aria-live="polite"></div>
		<div class="meta">
			<p>New to Cirrus? Enter your email and an account will be created for you.</p>
		</div>
{{template "page_bottom"}}
