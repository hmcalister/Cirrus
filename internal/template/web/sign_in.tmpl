{{define "sign_in_error"}}{{template "message" .}}{{end}}
{{template "page_top" "Sign in"}}
		<h1>Sign in</h1>
		<form hx-post="/sign-in" hx-disabled="find button" hx-target="#status">
			{{template "email_field"}}
			<label>
				Password
				<input type="password" name="password" autocomplete="current-password" required>
			</label>
			<button type="submit">Sign in</button>
		</form>
		{{template "status"}}
		<div class="meta">
			<p><a href="/register">Create an account</a></p>
			<p><a href="/password/reset">Reset your password</a></p>
		</div>
{{template "page_bottom"}}
