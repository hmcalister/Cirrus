{{/* Shared account sections. */}}

{{define "account_active"}}
<section class="setting" id="account-active" hx-swap-oob="true">
	<div class="setting-row">
		<span>
			<h2>Daily emails</h2>
			<p>{{if .Active}}Emails are being delivered to your inbox.{{else}}Delivery is currently paused.{{end}}</p>
		</span>
		<span class="badge{{if not .Active}} paused{{end}}">{{if .Active}}Active{{else}}Paused{{end}}</span>
	</div>
	<form hx-post="/account/setActive" hx-target="#status" hx-disabled="find button">
		<input type="hidden" name="activeStatus" value="{{not .Active}}">
		<button type="submit" class="secondary">{{if .Active}}Pause emails{{else}}Resume emails{{end}}</button>
	</form>
</section>
{{end}}

{{define "account_active_status"}}{{template "message" .}}
{{template "account_active" .}}{{end}}
