{{define "account_error"}}{{template "message" .}}{{end}}
{{template "page_top" "Account"}}
		<h1>Your account</h1>
		<p class="sub email">{{.Email}}</p>

		{{template "account_active" .}}
		{{template "status"}}

		<div class="danger-zone">
			<form hx-post="/logout" hx-disabled="find button" hx-target="#status">
				<button type="submit" class="secondary">Sign out</button>
			</form>
			<form hx-post="/account/logout-all" hx-disabled="find button" hx-target="#status">
				<button type="submit" class="secondary">Sign out everywhere</button>
			</form>
			<form hx-post="/account/delete" hx-confirm="Delete your account permanently? This cannot be undone." hx-disabled="find button" hx-target="#status">
				<button type="submit" class="danger">Delete account</button>
			</form>
		</div>
{{template "page_bottom"}}
